{
  "name": "@corlabsdev/mcp",
  "version": "0.1.3",
  "description": "MCP server that gives AI coding agents scored, maintainable, parameterised locators from a live page, in the test framework your repo already uses, then checks and repairs them.",
  "homepage": "https://corlabs.dev",
  "keywords": [
    "mcp",
    "locators",
    "ui automation",
    "test-automation",
    "playwright",
    "cypress",
    "webdriverio",
    "selenium",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "cor-mcp": "./dist/cor-mcp.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "tsup",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:golden": "node --test tests/golden/golden.test.js",
    "dev:local-engine": "npm --prefix ../.. run dev:local-engine",
    "dev:pinned-engine": "npm --prefix ../.. run dev:pinned-engine",
    "prepublishOnly": "node scripts/release-guard.js && npm run build && npm test",
    "release:check": "npm run dev:pinned-engine && npm run build && npm test && node scripts/release-guard.js && npm pack --dry-run",
    "release:smoke": "npm run build && node scripts/smoke.js",
    "release:patch": "npm version patch --tag-version-prefix=mcp-v -m \"mcp %s\"",
    "release:publish": "npm publish --access public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@corlabs/engine": "github:kushshah12/cor-locator-engine#v3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
